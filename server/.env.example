# Note: on macOS the ControlCenter (AirPlay Receiver) may occupy port 5000 —
# use 5001 locally in that case (Render sets PORT itself in production).
PORT=5000
NODE_ENV=development

# MongoDB (Atlas). Replace user/password with your own.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/

# Google AI Studio key — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional override (defaults to gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Comma-separated allow-list of frontend origins ("*" allows all — dev only)
CLIENT_URL=http://localhost:5173
